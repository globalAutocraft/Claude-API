# Copy this file to .env and fill in the values.

# Port the backend listens on.
PORT=3000

# Shared secret. Apps Script sends this in every request; anything without it is rejected.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_SECRET=change-me-to-a-long-random-string

# Model alias or full ID (e.g. sonnet, opus, claude-opus-5-5).
CLAUDE_MODEL=sonnet

# System prompt for the website chatbot.
SYSTEM_PROMPT=You are a helpful assistant on my personal website. Answer clearly and concisely.

# ---------------- Authentication (pick ONE) ----------------
#
# A) Personal use with YOUR Claude subscription (only you use the chatbot):
#    - Running on your own PC where you've run `claude` and logged in: leave both blank.
#    - Running on a server: run `claude setup-token` on your PC and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
#
# B) Website used by other people (employees, customers, public):
#    Anthropic requires API-key billing for that. Set a Console key here.
#    If this is set, it takes priority and usage is billed to your API account.
ANTHROPIC_API_KEY=
